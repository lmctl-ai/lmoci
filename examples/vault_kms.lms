# OCI Vault & KMS envelope encryption and redacted secret lifecycle.
mkdir("data");
oci = _dsl_ schema="../schema/lmoci.dsl.json";
let cloud = oci.demo();
let vault = cloud.vault_create("lmoci-demo-vault");
let key = cloud.key_create("lmoci-master-key");
let kid = key.get("id");
let enc = cloud.kms_encrypt(kid, "classified-payload-2026");
let cipher = enc.get("ciphertext");
check(str_len(cipher) > 0);
let dec = cloud.kms_decrypt(kid, cipher);
check(dec.get("plaintext") == "classified-payload-2026");
let sec = cloud.secret_create("app-db-pass", vault.get("id"), kid, "super-secret-value");
let bundle = cloud.secret_get(sec.get("id"));
check(bundle.get("secret_value") == "***REDACTED***");
end _dsl_
savedsl(oci, "data/vault-kms-oci.dslb");
