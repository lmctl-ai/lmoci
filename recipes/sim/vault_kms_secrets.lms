# Access: Write to ocisim with the native lmoci host
# What: Secrets for a web app: a vault, an AES key, encrypt/decrypt round trip of a database password, a vault secret whose value stays redacted on read, vault and secret inventories
# When: Wiring configuration secrets and envelope encryption for a site
# Emulator: ocisim (Vault, KMS, Secrets) on http://127.0.0.1:4599
# Run: lmscript recipes/sim/vault_kms_secrets.lms
# Arguments: --endpoint URL --host PATH --run ID --out DIR
# Cleanup: vaults, keys and secrets have no delete in the host API; they live in the emulator's memory until it restarts
import "./lib/common.lms";

o = sim_options("vault_kms_secrets", {}, "usage: vault_kms_secrets.lms [--endpoint URL] [--host PATH]");
raw = o.out + "/vault.json";

program = _lmcode_ cli="lmoci";
let cloud = oci.endpoint(${o.region}, ${o.endpoint});
let vault = cloud.vault_create(${"lmoci-sim-vault-" + o.run});
let key = cloud.key_create(${"lmoci-sim-app-key-" + o.run});
let encrypted = cloud.kms_encrypt(key.get("id"), "db-password-" + ${o.run});
let decrypted = cloud.kms_decrypt(key.get("id"), encrypted.get("ciphertext"));
let secret = cloud.secret_create(${"lmoci-sim-db-password-" + o.run}, vault.get("id"), key.get("id"), "db-password-" + ${o.run});
let fetched = cloud.secret_get(secret.get("id"));
let vaults = cloud.vaults();
let secrets = cloud.secrets();
file_write(${raw}, "{\"vault\":" + vault.json() + ",\"key\":" + key.json() + ",\"encrypted\":" + encrypted.json() + ",\"decrypted\":" + decrypted.json() + ",\"secret\":" + secret.json() + ",\"fetched\":" + fetched.json() + ",\"vaults\":" + vaults.json() + ",\"secrets\":" + secrets.json() + ",\"cost\":" + cloud.cost_summary().json() + "}");
end _lmcode_

sim_run(program, oci_native_command(o));
v = sim_read_json(raw);
assert(getstr(v, "key.status") == "ENABLED" && getstr(v, "key.algorithm") == "AES", "the key must be an enabled AES key");
assert(getstr(v, "decrypted.plaintext") == "db-password-" + o.run && getstr(v, "encrypted.ciphertext") != "", "KMS must round-trip the password");
assert(getstr(v, "fetched.secret_value") == "***REDACTED***" && getnum(v, "fetched.version_number") == 1, "the host must never print secret values");
assert(len(filter_by(v.vaults, "id", v.vault.id)) == 1 && len(filter_by(v.secrets, "id", v.secret.id)) == 1, "vault and secret inventories must list the new entries");
println("vault " + v.vault.display_name + ", key " + v.key.display_name + " (" + v.key.algorithm + "-" + str(getnum(v, "key.length") * 8) + "), ciphertext " + str(len(getstr(v, "encrypted.ciphertext"))) + " chars round-tripped; secret " + v.secret.secret_name + " v" + str(getnum(v, "fetched.version_number")) + " reads back redacted");
println("requests so far: " + str(getnum(v, "cost.total_requests")) + ", estimated $" + str(getnum(v, "cost.estimated_usd")));
sim_report(o, {endpoint: o.endpoint, host: "lmoci", vault: v});
sim_pass(o);
